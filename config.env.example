# weather-reporter configuration
# Copy to config.env and fill in. config.env is git-ignored - never commit it.
# Re-run ./setup.sh after changing RUN_TIME.

# Discord webhook (Channel Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/REPLACE_ME"

# Location
LOCATION_NAME="New York, NY"
LATITUDE="40.7128"
LONGITUDE="-74.0060"

# Daily run time (24-hour HH:MM) in the container's system time zone.
# Check the container's time zone with: date
RUN_TIME="08:00"

# Warning thresholds
# Warn if any period tomorrow has >= this % chance of rain
RAIN_THRESHOLD="30"
# Show the rain line only if today or tonight has >= this % chance of rain
RAIN_SHOW_THRESHOLD="10"
# Warn if tonight's low is <= this temperature (F)
FREEZE_THRESHOLD_F="32"

# Contact info for the NWS API User-Agent header (they ask for an email or URL)
CONTACT="you@example.com"
